# Settings shared by all ZPLSC units. Copy to /etc/zplsc/common.env and adjust for the host.
# Container image, built from the repository Dockerfile (use a dated tag, not latest)
IMAGE=ooi-zpls-echograms:2026.10
# Host directory holding the cabled raw data tree; mounted read-only at /node_data in the container
RAW_MOUNT=/rsn_cabled/rsn_data/DVT_Data
# Host directory for processed output; mounted at the same path in the container
PROC_MOUNT=/data/zplsc
# Lock shared by every ZPLSC unit so that only one job runs at a time
LOCK_FILE=/var/lib/zplsc/zplsc.lock
# Host directory for the weekly backlog's per-week logs (one subdirectory per site)
LOG_DIR=/var/log/zplsc
# Number of complete weeks the weekly backlog reprocesses
N_WEEKS=1
